<?xml version="1.0"?>
<robot name="omx_l" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="prefix" default="" />
  <xacro:arg name="use_mock_hardware" default="false" />
  <xacro:arg name="port_name" default="/dev/ttyACM1" />

  <xacro:include filename="$(find omx_description)/urdf/omx_l_arm.urdf.xacro" />
  <xacro:include filename="$(find omx_description)/urdf/omx_l.ros2_control.xacro" />

  <link name="world"/>

  <joint name="$(arg prefix)world_fixed" type="fixed">
    <parent link="world"/>
    <child link="$(arg prefix)link0"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  </joint>

  <!-- 機構本體（omx_l_arm.urdf.xacro 定義的 macro） -->
  <xacro:omx_l prefix="$(arg prefix)" />
  <xacro:omx_l_system name="OmxLSystem"
                      prefix="$(arg prefix)"
                      use_mock_hardware="$(arg use_mock_hardware)"
                      port_name="$(arg port_name)"/>

</robot>
