<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find omx_description)/urdf/dxl_x_series.xacro"/>

  <xacro:macro name="omx_f_system"
               params="name prefix
                       use_mock_hardware:=true port_name:=/dev/ttyACM0
                       drive_mode:=4
                       profile_velocity:=50 profile_acceleration:=25">

    <ros2_control name="${name}" type="system">

      <hardware>
        <xacro:if value="${use_mock_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">true</param>
        </xacro:if>
        <xacro:unless value="${use_mock_hardware}">
          <plugin>dynamixel_hardware/DynamixelSystem</plugin>
          <param name="port_name">${port_name}</param>
          <param name="baud_rate">1000000</param>
        </xacro:unless>
      </hardware>

      <xacro:dxl_x_position_joint joint_name="${prefix}joint1" device_id="11"
                                  operating_mode="extended_position"
                                  drive_mode="${drive_mode}"
                                  profile_velocity="${profile_velocity}"
                                  profile_acceleration="${profile_acceleration}"/>

      <xacro:dxl_x_position_joint joint_name="${prefix}joint2" device_id="12"
                                  drive_mode="${drive_mode}"
                                  profile_velocity="${profile_velocity}"
                                  profile_acceleration="${profile_acceleration}"
                                  min_position_limit="0" max_position_limit="4095"/>

      <xacro:dxl_x_position_joint joint_name="${prefix}joint3" device_id="13"
                                  drive_mode="${drive_mode}"
                                  profile_velocity="${profile_velocity}"
                                  profile_acceleration="${profile_acceleration}"
                                  min_position_limit="0" max_position_limit="4095"/>

      <xacro:dxl_x_position_joint joint_name="${prefix}joint4" device_id="14"
                                  drive_mode="${drive_mode}"
                                  profile_velocity="${profile_velocity}"
                                  profile_acceleration="${profile_acceleration}"/>

      <xacro:dxl_x_position_joint joint_name="${prefix}joint5" device_id="15"
                                  drive_mode="${drive_mode}"
                                  profile_velocity="${profile_velocity}"
                                  profile_acceleration="${profile_acceleration}"/>

      <xacro:dxl_x_current_position_joint joint_name="${prefix}gripper_joint_1"
                                          device_id="16"
                                          current_limit="600"
                                          goal_current="600"
                                          drive_mode="${drive_mode}"
                                          profile_velocity="${profile_velocity}"
                                          profile_acceleration="${profile_acceleration}"/>

    </ros2_control>

  </xacro:macro>
</robot>
